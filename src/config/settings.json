{
	"tabs": {
		"layout": true,
		"style": true,
		"grid": true,
		"settings": true
	},
	"fields": {
		"content": {
			"column-blocks": [
				"multicolumnheadline",
				"multicolumntagline",
				"multicolumntext",
				"multicolumnlist",
				"multicolumnquote",
				"multicolumnmedia",
				"multicolumnbutton"
			],
			"headline": {
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				},
				"level": {
					"options": [
						"h1",
						"h2",
						"h3",
						"h4"
					],
					"default": "h2"
				},
				"sizes": {
					"options": [
						"xs",
						"sm",
						"md",
						"lg",
						"xl",
						"2xl",
						"3xl"
					],
					"default": "lg"
				},
				"textbackground": {
					"options": [
						"disabled",
						"enabled"
					],
					"default": "disabled"
				},
				"flourish": {
					"options": [
						"disabled",
						"enabled"
					],
					"default": "disabled"
				}
			},
			"text": {
				"mode": {
					"options": [
						"textarea",
						"writer"
					],
					"default": "textarea"
				},
				"align": {
					"options": [
						"left",
						"center",
						"right",
						"justify"
					],
					"default": "left"
				},
				"sizes": {
					"options": [
						"normal",
						"lg",
						"xl",
						"2xl",
						"3xl"
					],
					"default": "normal"
				}
			},
			"list": {
				"style": {
					"options": [
						"bullet",
						"ordered",
						"none"
					],
					"default": "bullet"
				},
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				},
				"sizes": {
					"options": [
						"normal",
						"lg",
						"xl",
						"2xl",
						"3xl"
					],
					"default": "normal"
				}
			},
			"quote": {
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				},
				"sizes": {
					"options": [
						"xs",
						"sm",
						"md",
						"lg",
						"xl",
						"2xl",
						"3xl"
					],
					"default": "lg"
				}
			},
			"author": {
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				}
			},
			"media": {
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				}
			},
			"button": {
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				}
			},
			"tagline": {
				"align": {
					"options": [
						"left",
						"center",
						"right"
					],
					"default": "left"
				}
			}
		},
		"layout": {
			"padding": "enabled",
			"padding-top": {
				"default": "large"
			},
			"padding-bottom": {
				"default": "large"
			},
			"padding-left": {
				"default": true
			},
			"padding-right": {
				"default": true
			},
			"columns-sm": {
				"options": [
					"dist-1-5",
					"dist-2-4",
					"dist-3-3",
					"dist-4-2",
					"dist-5-1"
				],
				"default": ""
			},
			"columns-md": {
				"options": [
					"dist-1-5",
					"dist-2-4",
					"dist-3-3",
					"dist-4-2",
					"dist-5-1"
				],
				"default": "dist-3-3"
			},
			"columns-lg": {
				"options": [
					"dist-1-5",
					"dist-2-4",
					"dist-3-3",
					"dist-4-2",
					"dist-5-1"
				],
				"default": "dist-3-3"
			},
			"columns-xl": {
				"options": [
					"dist-1-5",
					"dist-2-4",
					"dist-3-3",
					"dist-4-2",
					"dist-5-1"
				],
				"default": "dist-3-3"
			},
			"multicolumn-left": {
				"options": [
					"top",
					"middle",
					"bottom"
				],
				"default": "top"
			},
			"multicolumn-right": {
				"options": [
					"top",
					"middle",
					"bottom"
				],
				"default": "top"
			},
			"radius": "enabled",
			"radius-top-left": {
				"default": false
			},
			"radius-top-right": {
				"default": false
			},
			"radius-bottom-left": {
				"default": false
			},
			"radius-bottom-right": {
				"default": false
			},
			"item-spacing": {
				"label": "pw.field.item-spacing",
				"options": [
					"global",
					"own"
				],
				"default": "global"
			}
		},
		"style": {
			"theme": {
				"options": [
					"default",
					"variant",
					"variant2",
					"variant3",
					"custom"
				],
				"required": true,
				"default": "default"
			}
		},
		"grid": {
			"grid-size-sm": {
				"default": 12
			},
			"grid-size-md": {
				"default": 12
			},
			"grid-size-lg": {
				"default": 12
			},
			"grid-size-xl": {
				"default": 12
			},
			"grid-offset-sm": {
				"default": 0
			},
			"grid-offset-md": {
				"default": 0
			},
			"grid-offset-lg": {
				"default": 0
			},
			"grid-offset-xl": {
				"default": 0
			}
		},
		"settings": {
			"block-size": {
				"options": [
					"content",
					"fullscreen"
				],
				"required": true,
				"fixed": true,
				"default": "content"
			},
			"margin-top": {
				"default": false
			},
			"margin-bottom": {
				"default": true
			}
		}
	},
	"values": {
		"columns": {
			"vars": {
				"column-gap": {
					"default": "1.5rem",
					"lg": "2rem",
					"xl": "2rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 10
				},
				"row-gap": {
					"value": "2rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 10
				}
			}
		},
		"elements": {
			"vars": {
				"tagline-spacing": {
					"value": "0.5rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 6
				},
				"heading-spacing": {
					"value": "0.5rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 6
				},
				"editor-spacing": {
					"value": "1.2rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 6
				},
				"quote-spacing": {
					"value": "2rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 6
				},
				"media-spacing": {
					"value": "2rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 6
				},
				"button-spacing": {
					"value": "1rem",
					"unit": "rem",
					"step": 0.1,
					"min": 0,
					"max": 6
				},
				"list-spacing": {
					"value": "1em",
					"unit": "em",
					"step": 0.1,
					"min": 0,
					"max": 6
				}
			}
		}
	}
}
